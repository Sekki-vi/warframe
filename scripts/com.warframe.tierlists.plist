<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.warframe.tierlists</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>build_tier_lists.py</string>
    <string>--scrape</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_WARFRAME_PROJECT_PATH</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/warframe-tierlists.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/warframe-tierlists.err</string>
</dict>
</plist>
