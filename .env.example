# Required - OpenAI (embeddings + chat)
OPENAI_API_KEY=

# UI backend — Manager FastAPI server (Streamlit app.py connects here)
BACKEND_URL=http://localhost:8502

# Manager router (classification fallback only)
MANAGER_CHAT_MODEL=gpt-4o-mini

# Required - Pinecone (vector DB)
PINECONE_API_KEY=pcsk_...

# Required - Pinecone index (1536-dim, cosine)
PINECONE_INDEX=warframe

# Optional - logical partition within the index
PINECONE_NAMESPACE=warframe

# Embedding model config
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
BATCH_SIZE=100

# Knowledge agent
CHAT_MODEL=gpt-4o-mini
TOP_K=5
TEMPERATURE=0.3
MAX_HISTORY=20

# Forecasting agent
OPENAI_MODEL=gpt-4.1-mini
AGENT_PUBLIC_URL=http://localhost:8502
