# Required - OpenAI (embeddings + chat)
OPENAI_API_KEY=sk-...

# Required - Pinecone (vector DB)
PINECONE_API_KEY=pcsk_...

# Required - Pinecone index (1536-dim, cosine)
PINECONE_INDEX=warframe

# Optional - logical partition within the index
PINECONE_NAMESPACE=warframe-items

# Embedding model config
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
BATCH_SIZE=100

# Chat / Flask
CHAT_MODEL=gpt-4o-mini
TOP_K=5
FLASK_PORT=5001
FLASK_SECRET_KEY=change-me-to-a-random-string
TEMPERATURE=0.3
MAX_HISTORY=20

# Optional - path to folder containing warframe_all_orders_raw.csv
# Only needed for build_pipeline.py and build_orders_db.py
ORDERS_DATA_DIR=/path/to/your/Warframe Data
